{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
	"outDir": "dist",
	"esModuleInterop": true,
	"rootDir": "./src/"
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
