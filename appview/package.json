    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "multiformats": "^14.0.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
