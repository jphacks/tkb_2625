{
  "id": "win.tomo-x.rogaining.listSubmissions",
  "defs": {
    "main": {
      "type": "query",
      "errors": [{ "name": "EventNotFound" }],
      "output": {
        "schema": {
          "type": "object",
          "required": ["submissions"],
          "properties": {
            "cursor": { "type": "string" },
            "submissions": {
              "type": "array",
              "items": {
                "ref": "win.tomo-x.rogaining.defs#submissionView",
                "type": "ref"
              }
            }
          }
        },
        "encoding": "application/json"
      },
      "parameters": {
        "type": "params",
        "required": ["event"],
        "properties": {
          "event": { "type": "string", "format": "at-uri" },
          "checkpoint": { "type": "string", "format": "at-uri" },
          "participant": { "type": "string", "format": "did" },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          "cursor": { "type": "string" }
        }
      },
      "description": "List submissions for an event, newest first. The event's author and approver see every team's submissions; a participant sees only their own team's. Anyone else gets an empty list."
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
