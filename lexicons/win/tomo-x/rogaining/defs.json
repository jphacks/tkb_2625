{
  "id": "win.tomo-x.rogaining.defs",
  "defs": {
    "location": {
      "type": "object",
      "required": ["latitude", "longitude"],
      "properties": {
        "latitude": { "type": "string", "maxLength": 20 },
        "longitude": { "type": "string", "maxLength": 20 }
      },
      "description": "Coordinates as decimal degrees encoded as strings (lexicon has no float type), e.g. \"35.681236\"."
    },
    "teamView": {
      "type": "object",
      "required": ["uri", "cid", "record", "members", "indexedAt"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "uri": { "type": "string", "format": "at-uri" },
        "record": {
          "type": "unknown",
          "description": "The win.tomo-x.rogaining.team record."
        },
        "members": {
          "type": "array",
          "items": {
            "ref": "app.bsky.actor.defs#profileViewBasic",
            "type": "ref"
          },
          "description": "Profiles of the team members."
        },
        "indexedAt": { "type": "string", "format": "datetime" }
      }
    },
    "eventView": {
      "type": "object",
      "required": ["uri", "cid", "author", "record", "indexedAt"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "uri": { "type": "string", "format": "at-uri" },
        "author": {
          "ref": "app.bsky.actor.defs#profileViewBasic",
          "type": "ref"
        },
        "record": {
          "type": "unknown",
          "description": "The win.tomo-x.rogaining.event record."
        },
        "approver": {
          "ref": "app.bsky.actor.defs#profileViewBasic",
          "type": "ref"
        },
        "imageUrl": { "type": "string", "format": "uri" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "teamCount": { "type": "integer", "minimum": 0 },
        "checkpointCount": { "type": "integer", "minimum": 0 },
        "participantCount": { "type": "integer", "minimum": 0 }
      }
    },
    "rankingEntry": {
      "type": "object",
      "required": ["team", "rank", "totalPoints", "approvedCount"],
      "properties": {
        "rank": { "type": "integer", "minimum": 1 },
        "team": { "ref": "win.tomo-x.rogaining.defs#teamView", "type": "ref" },
        "totalPoints": {
          "type": "integer",
          "minimum": 0,
          "description": "Sum of approved checkpoint points and the team's finish-time bonus."
        },
        "approvedCount": {
          "type": "integer",
          "minimum": 0,
          "description": "Number of distinct non-goal checkpoints with an approved submission."
        }
      }
    },
    "checkpointView": {
      "type": "object",
      "required": ["uri", "cid", "record", "indexedAt"],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "uri": { "type": "string", "format": "at-uri" },
        "record": {
          "type": "unknown",
          "description": "The win.tomo-x.rogaining.checkpoint record."
        },
        "indexedAt": { "type": "string", "format": "datetime" },
        "imageUrl": {
          "type": "string",
          "format": "uri",
          "description": "URL of the checkpoint image."
        },
        "internalImageUrls": {
          "type": "array",
          "items": { "type": "string", "format": "uri" },
          "maxLength": 10,
          "description": "URLs of the internal images. Only returned to the event's author."
        }
      }
    },
    "submissionView": {
      "type": "object",
      "required": [
        "uri",
        "cid",
        "author",
        "team",
        "record",
        "status",
        "indexedAt"
      ],
      "properties": {
        "cid": { "type": "string", "format": "cid" },
        "uri": { "type": "string", "format": "at-uri" },
        "author": {
          "ref": "app.bsky.actor.defs#profileViewBasic",
          "type": "ref"
        },
        "team": {
          "type": "string",
          "format": "at-uri",
          "description": "The team the author belongs to in this event."
        },
        "record": {
          "type": "unknown",
          "description": "The win.tomo-x.rogaining.submit record."
        },
        "status": {
          "type": "string",
          "description": "approved when a valid approve record by the event's approver exists, otherwise rejected when a valid reject record by the approver exists, otherwise pending. Only approved submissions count for the ranking.",
          "knownValues": ["pending", "approved", "rejected"]
        },
        "photoUrl": { "type": "string", "format": "uri" },
        "indexedAt": { "type": "string", "format": "datetime" },
        "approvalUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the approve record, if approved."
        },
        "rejectionUri": {
          "type": "string",
          "format": "at-uri",
          "description": "AT-URI of the reject record, if rejected by the approver."
        },
        "reason": {
          "type": "string",
          "description": "The reason of the approve or reject record that decided the status."
        },
        "distanceMeters": {
          "type": "integer",
          "minimum": 0,
          "description": "Distance between the submitted location and the checkpoint, for the approver's review."
        },
        "withinEventPeriod": {
          "type": "boolean",
          "description": "Whether the submission's createdAt is between the event's startsAt and endsAt, for the approver's review."
        }
      }
    }
  },
  "$type": "com.atproto.lexicon.schema",
  "lexicon": 1
}
